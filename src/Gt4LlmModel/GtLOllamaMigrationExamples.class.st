{ #category : #examples }
GtLOllamaMigrationExamples >> gemma4Image [
	"Answer the model and chat for a query and image with Gemma4:31b.
	noTest as this assumes a local Ollama installation with gemma4:31b available."
	<gtExample>
	| provider executor image chat msg jsonDictionary requestJson |

	executor := GtLOllamaCompletionsExampleExecutor new.
	executor loadExpectedHistoryFrom: self gemma4ImageHistory.
	image := FileSystem memory root / 'image.jpg'.
	PluginBasedJPEGReadWriter 
		putForm: (Smalltalk ui icons iconNamed: 'arrowUp') 
		onFileNamed: image.
	provider := executor provider.
	provider modelName: 'gemma4:e4b'.
	chat := executor chat.
	
	msg := chat createUserMessage.
	msg string: 'Please describe the attached image.'.
	msg images: { image }.
	chat sendMessage: msg.
	executor waitTimeoutSeconds: 60.
	GtLModelExamples
		compareShapes: chat messages
		with: executor expectedHistory.
	jsonDictionary := NeoJSONReader fromString: chat messages first requestResponse request contents.
	requestJson := (jsonDictionary at: 'messages') first
			at: 'content'.
	self assert: (requestJson anySatisfy: [ :aDictionary |
		(aDictionary includesKey: 'image_url') and:
		[ (aDictionary at: 'type') = 'image_url' ] ]).

	^ chat
]

