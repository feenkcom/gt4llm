Class {
	#name : #GtLOpenAiResponsesExamples,
	#superclass : #GtLModelExamples,
	#category : #'Gt4LlmCore-Examples-Model'
}

{ #category : #'examples - compaction' }
GtLOpenAiResponsesExamples >> assistantMessageIgnoresAutomaticCompactionResponse [
	<gtExample>
	| provider input result assistant compactionMessages |

	provider := GtLOpenAiResponsesProvider new.
	input := GtLModelUserMessage new.
	result := GtLModelResponse from: {
		'output' -> {
			{
				'type' -> 'compaction'.
				'encrypted_content' -> 'automatic' } asDictionary.
			{ 'type' -> 'message' } asDictionary }
	} asDictionary.

	assistant := provider
		responseTypeForResult: result
		fromInputMessage: input.
	compactionMessages := provider
		automaticCompactionMessagesFrom: result
		inputMessage: input.

	self deny: assistant hasCompactionResponse.
	self assert: compactionMessages size equals: 1.
	self assert: compactionMessages first hasCompactionResponse.

	^ assistant
]

{ #category : #'examples - compaction' }
GtLOpenAiResponsesExamples >> automaticCompactionMessagesFromResponse [
	<gtExample>
	| provider input result firstOutput secondOutput messages |

	provider := GtLOpenAiResponsesProvider new.
	input := GtLModelUserMessage new.
	firstOutput := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'first'
	} asDictionary.
	secondOutput := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'second'
	} asDictionary.
	result := GtLModelResponse from: {
		'output' -> {
			firstOutput.
			{ 'type' -> 'message' } asDictionary.
			secondOutput }
	} asDictionary.

	messages := provider
		automaticCompactionMessagesFrom: result
		inputMessage: input.

	self assert: messages size equals: 2.
	self assert: messages first rawData == firstOutput.
	self assert: messages second rawData == secondOutput.
	self
		assert: (messages first providerDataFor: provider ifAbsent: [ nil ])
		== firstOutput.
	self
		assert: (messages second providerDataFor: provider ifAbsent: [ nil ])
		== secondOutput.
	self assert: messages first requestResponse == result requestResponse.
	self assert: messages second requestResponse == result requestResponse.

	^ messages
]

{ #category : #'examples - compaction' }
GtLOpenAiResponsesExamples >> automaticCompactionMessagesPartitionedAroundAssistantMessage [
	<gtExample>
	| provider input result firstOutput secondOutput messages partition |

	provider := GtLOpenAiResponsesProvider new.
	input := GtLModelUserMessage new.
	firstOutput := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'first'
	} asDictionary.
	secondOutput := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'second'
	} asDictionary.
	result := GtLModelResponse from: {
		'output' -> {
			firstOutput.
			{ 'type' -> 'message' } asDictionary.
			secondOutput }
	} asDictionary.

	messages := provider
		automaticCompactionMessagesFrom: result
		inputMessage: input.
	partition := provider
		partitionAutomaticCompactionMessages: messages
		from: result
		inputMessage: input.

	self assert: partition first size equals: 1.
	self assert: partition first first rawData == firstOutput.
	self assert: partition second size equals: 1.
	self assert: partition second first rawData == secondOutput.
	^ partition
]

{ #category : #examples }
GtLOpenAiResponsesExamples >> copyOpenAICompactionMessage [
	<gtExample>
	<return: #GtLOpenAICompactionMessage>
	| originalChat newChat compactionMessage copiedCompaction |
	
	originalChat := GtLChat new.
	originalChat provider: GtLOpenAiResponsesProvider new.
	
	newChat := GtLChat new.
	newChat provider: GtLOpenAIProvider new.
	
	compactionMessage := GtLModelCompactionMessage new.
	compactionMessage rawData: Dictionary new for: originalChat provider.
	compactionMessage chat: originalChat.
	copiedCompaction := compactionMessage copyForIndependentRequestInChat: newChat.
	
	GtLOpenAIProviderCopyChatExamples new
		assertCopiedChatMessage: copiedCompaction 
		isCopyOf: compactionMessage forChat: newChat.
	self assert: compactionMessage chat == originalChat.
	
	^ copiedCompaction
]

{ #category : #'examples - compaction' }
GtLOpenAiResponsesExamples >> emptyPortableCompactionContentIsAbsent [
	<gtExample>
	| message provider |

	message := GtLModelCompactionMessage new portableContentText: ''.
	provider := GtLOllamaProvider new.

	self assert: message portableContentText isNil.
	self assert: message hasPortableContent not.
	self assert: (message canSerializeFor: provider) not.
	^ message
]

{ #category : #'examples - compaction' }
GtLOpenAiResponsesExamples >> equivalentProviderReusesNativeCompaction [
	<gtExample>
	| originatingProvider replacementProvider chat output message serialized |

	originatingProvider := GtLOpenAiResponsesProvider new.
	replacementProvider := GtLOpenAiResponsesProvider new.
	chat := GtLChat new provider: originatingProvider.
	output := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'opaque-data'
	} asDictionary.
	message := GtLModelCompactionMessage new.
	message rawData: output for: originatingProvider; chat: chat.

	chat provider: replacementProvider.
	self assert: message hasResponse.
	serialized := GtLOpenAiResponsesMessageVisitor new chatMessage: message.

	self assert: serialized == output.
	self assert: message providerForSerialization == replacementProvider.
	^ serialized
]

{ #category : #'examples - compaction switching' }
GtLOpenAiResponsesExamples >> incompatibleOpaqueCompactionIsOmittedFromHistory [
	<gtExample>
	| openAi ollama chat strategy firstUser compaction lastUser relevant |

	openAi := GtLOpenAiResponsesProvider new.
	ollama := GtLOllamaProvider new.
	ollama completions.
	chat := GtLChat new provider: ollama.
	firstUser := GtLModelUserMessage new.
	chat addUserMessage: firstUser.
	compaction := GtLModelCompactionMessage new.
	compaction rawData: {
		'type' -> 'compaction'.
		'encrypted_content' -> 'opaque-data'
	} asDictionary for: openAi.
	chat addCompactionMessage: compaction.
	lastUser := GtLModelUserMessage new.
	chat addUserMessage: lastUser.

	strategy := GtLNoCompactionStrategy forProvider: ollama.
	relevant := strategy relevantChatMessagesFor: chat.

	self assert: (relevant includes: firstUser).
	self deny: (relevant includes: compaction).
	self assert: (relevant includes: lastUser).
	^ relevant
]

{ #category : #'examples - compaction' }
GtLOpenAiResponsesExamples >> independentCopyOfServerSideCompactionMessage [
	<gtExample>
	<return: #GtLModelCompactionMessage>
	| original provider equivalentProvider output copied |

	original := self opaqueServerSideCompactionMessage.
	provider := GtLOpenAiResponsesProvider new.
	output := original rawData.
	copied := original copyForIndependentRequestInChat: nil.

	self assert: copied ~~ original.
	self
		assert: (copied providerDataFor: provider ifAbsent: [ nil ])
		== output.

	equivalentProvider := GtLOpenAiResponsesProvider new.
	self
		assert: (copied providerDataFor: equivalentProvider ifAbsent: [ nil ])
		== output.
	copied providerData: Dictionary new for: equivalentProvider.
	self assert: original rawData == output.
	^ copied
]

