{ #category : #examples }
GtLOllamaMigrationExamples >> qwen35ResponsesObjectInspection [
	"Ask qwen3.5 to inspect the supplied object and describe it."
	<gtExample>
	| chat executor provider chatObject storedObjectId objectStorage |
	
	executor := GtLOllamaResponsesExampleExecutor new.
	provider := executor provider.
	provider modelName: 'qwen3.5:9b'.
	executor loadExpectedHistoryFrom: self qwen35ResponsesObjectInspectionHistory.
	chat := executor chat.
	chatObject := { 'info' -> 'Today is overcast in the Czech Republic' } asDictionary.
	storedObjectId := chat addNewObject: chatObject reasonString: 'Info object'.
	chat 
		tools: (GtLTools withAll: GtLTools gtObjectsExecution);
		sendString: 'Describe the stored object named ''Info object''.'.
	executor waitTimeoutSeconds: 60.
	executor assertHistoryResponsesOK: provider client history.
	GtLModelExamples
		compareShapes: chat messages
		with: executor expectedHistory.
	objectStorage := chat objectStorage.
	self assert: objectStorage size equals: 1.
	self assert: (objectStorage objectAt: storedObjectId) equals: chatObject.
	
	executor assertResponseResponsesStringContent: chat messages last finalMessage.

	^ chat
]

