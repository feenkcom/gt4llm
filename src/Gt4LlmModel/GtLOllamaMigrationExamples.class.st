{ #category : #examples }
GtLOllamaMigrationExamples >> qwen35CompletionsObjectInspection [
	"Ask qwen3.5 to inspect the supplied object and describe it."
	<gtExample>
	| chat executor provider chatObject storedObjectId inputModels |
	
	executor := GtLOllamaCompletionsExampleExecutor new.
	provider := executor provider.
	provider modelName: 'qwen3.5:9b'.
	executor loadExpectedHistoryFrom: self qwen35CompletionsObjectInspectionHistory.
	chat := executor chat.
	chatObject := { 'info' -> 'Today is overcast in the Czech Republic' } asDictionary.
	storedObjectId := chat addNewObject: chatObject reasonString: 'Info object'.
	chat 
		reasoningEffort: #none;
		tools: (GtLTools withAll: GtLTools gtObjectsExecution).
	chat sendWith: [ :message |
			message
				addPlainInputObject: chatObject
					withId: storedObjectId
					named: 'Info object';
				string: 'Describe the stored object named ''Info object''.'. ].
	executor waitTimeoutSeconds: 60.
	GtLModelExamples
		compareShapes: chat messages
		with: executor expectedHistory.
	executor assertHistoryResponsesOK: provider client history.
	inputModels := chat messages first inputModels.
	self assert: inputModels size equals: 2.
	self assert: inputModels first targetObject object equals: chatObject.
	
	executor assertResponseCompletionsStringContent: chat messages last finalMessage.

	^ chat
]

