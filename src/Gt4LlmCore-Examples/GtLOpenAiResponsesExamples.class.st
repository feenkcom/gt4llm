{ #category : #examples }
GtLOpenAiResponsesExamples >> messageWithToolCallThenCompactionExecutor [
	| executor |
	
	executor := GtLOpenAiResponsesExampleExecutor new.
	executor loadExpectedHistoryFrom: self messageWithToolCallThenCompactionExampleHistory.
	executor provider modelName: 'gpt-5.4'.
	^ executor
]

{ #category : #'as yet unclassified' }
GtLOpenAiResponsesExamples >> opaqueServerSideCompactionMessage [
	<gtExample>
	<return: #GtLModelCompactionMessage>
	| provider output message |

	provider := GtLOpenAiResponsesProvider new.
	output := {
		'type' -> 'compaction'.
		'encrypted_content' -> 'opaque-data'
	} asDictionary.

	message := GtLModelCompactionMessage new.
	message rawData: output for: provider.

	self assert: message currentProvider == provider.
	self assert: message rawData == output.
	self assert: message content equals: #().
	self assert: message contentText equals: ''.
	self deny: message hasContent.
	self assert: message hasResponse.
	self assert: message isServerSideCompactionOutput.

	^ message
]

{ #category : #examples }
GtLOpenAiResponsesExamples >> openAiResponsesMarkdownChat [
	"Check operation of the Ollama endpoint using a fake client"
	<gtExample>
	| executor provider chat |

	executor := GtLOpenAiResponsesExampleExecutor new.
	executor loadExpectedHistoryFrom: self openAiResponsesMarkdownChatHistory.
	provider := executor provider.
	provider modelName: 'gpt-5.4'.
	chat := executor chat.
	chat markdownResponse.

	chat sendMarkdown: 'Hi, who are you?'.
	executor waitTimeoutSeconds: 60.
	self compareShapes: chat messages with: executor expectedHistory.
	executor assertChatResponseOK: chat.
	executor assertResponseResponsesMarkdownContent: chat messages last.

	^ chat
]

{ #category : #'private - data' }
