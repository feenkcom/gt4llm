{ #category : #examples }
GtLOllamaMigrationExamples >> ollamaNomicEmbeddings [
	"Generate embeddings to match a query"
	<gtExample>
	| executor provider model command documents embeddings queryEmbeddings queryLlmEmbedding llmEmbeddings distances sorted chosen |

	executor := GtLModelExamplesExecutor new.
	provider := GtLOllamaProvider new
		generate;
		modelName: 'nomic-embed-text-v2-moe'.
	model := provider model.
	command := model newCreateEmbeddingsCommand.
	documents := {
	  'Our refund policy lasts 30 days.'.
	  'You can change your password from account settings.'.
	  'Shipping usually takes 5 to 7 business days.'. }.
	executor isLive ifTrue:
		[ command context input: documents.
		embeddings := command perform.
		command context input: 'How long does delivery take?'.
		queryEmbeddings := command perform. ]
	ifFalse:
		[ | fakeData |
		fakeData := self ollamaNomicEmbeddingsData.
		embeddings := GtLModelEmbeddings new
				input: fakeData first;
				embeddings: (fakeData second collect: 
					[ :each | Float32Array withAll: each ]);
				model: model.
		queryEmbeddings := GtLModelEmbeddings new
				input: fakeData third;
				embeddings: (fakeData fourth collect: 
					[ :each | Float32Array withAll: each ]);
				model: model. ].

	llmEmbeddings := (1 to: embeddings input size) collect: [ :i |
		GtLlmEmbedding new
			input: (embeddings input at: i);
			embedding: (embeddings embeddings at: i) ].
	queryLlmEmbedding := GtLlmEmbedding new
		input: command context input;
		embedding: queryEmbeddings embeddings first.
	distances := GtLlmEmbeddingsUtilities
			distancesFromEmbeddings: llmEmbeddings
			to: queryLlmEmbedding.
	sorted := distances sorted: #distance ascending.
	chosen := sorted first embedding input.

	self assert: chosen equals: documents last.
	^ { embeddings. queryEmbeddings.}
]

