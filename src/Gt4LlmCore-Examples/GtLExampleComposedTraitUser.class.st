"
I use TGtLExampleComposedTrait, so I get #traitMethod of TGtLExampleTrait through a trait composed of it.
"
Class {
	#name : #GtLExampleComposedTraitUser,
	#superclass : #Object,
	#traits : 'TGtLExampleComposedTrait',
	#classTraits : 'TGtLExampleComposedTrait classTrait',
	#category : #'Gt4LlmCore-Examples-Support'
}
