{ #category : #'examples - compaction' }
GtLOpenAiResponsesExamples >> portableCompactionSwitchesFromOpenAiToOllama [
	<gtExample>
	| openAi ollama chat message serialized |

	openAi := GtLOpenAiResponsesProvider new.
	ollama := GtLOllamaProvider new.
	ollama completions.
	chat := GtLChat new provider: openAi.
	message := GtLModelCompactionMessage new.
	message
		rawData: Dictionary new for: openAi;
		portableContentText: 'portable summary';
		chat: chat.

	self assert: message hasResponse.
	chat provider: ollama.
	self deny: message hasResponse.
	serialized := GtLOllamaCompletionsMessageVisitor new chatMessage: message.

	self assert: (serialized at: 'role') equals: 'assistant'.
	self
		assert: (((serialized at: 'content') first) at: 'text')
		equals: 'portable summary'.
	self assert: message providerForSerialization == ollama.
	^ serialized
]

{ #category : #'as yet unclassified' }
GtLOpenAiResponsesExamples >> relevantHistoryStartsAtLatestCompaction [
	<gtExample>
	| provider chat strategy firstUser firstCompaction assistant
	  secondUser secondCompaction lastUser relevant |

	provider := GtLOpenAiResponsesProvider new.
	chat := GtLChat new provider: provider.
	strategy := GtLOpenAiServerSideCompactionStrategy forProvider: provider.

	firstUser := GtLModelUserMessage new.
	chat addUserMessage: firstUser.

	firstCompaction := GtLModelCompactionMessage new.
	firstCompaction
		rawData: {
			'type' -> 'compaction'.
			'encrypted_content' -> 'first'
		} asDictionary
		for: provider.
	chat addCompactionMessage: firstCompaction.

	assistant := GtLModelAssistantMessage new.
	chat addAssistantMessage: assistant.

	secondUser := GtLModelUserMessage new.
	chat addUserMessage: secondUser.

	secondCompaction := GtLModelCompactionMessage new.
	secondCompaction
		rawData: {
			'type' -> 'compaction'.
			'encrypted_content' -> 'second'
		} asDictionary
		for: provider.
	chat addCompactionMessage: secondCompaction.

	lastUser := GtLModelUserMessage new.
	chat addUserMessage: lastUser.

	relevant := strategy relevantChatMessagesFor: chat.

	self assert: relevant size equals: 2.
	self assert: relevant first == secondCompaction.
	self assert: (relevant at: 2) == lastUser.
	self deny: (relevant includes: firstUser).
	self deny: (relevant includes: firstCompaction).
	self deny: (relevant includes: assistant).
	self deny: (relevant includes: secondUser).

	^ relevant
]

{ #category : #'examples - errors' }
GtLOpenAiResponsesExamples >> requestAfterErrorMessage [
	"Construct a continuation request locally without contacting the provider."
	<gtExample>
	| executor provider chat errorMessage message command endpoint context entity input |
	executor := GtLOpenAiResponsesExampleExecutor new.
	provider := executor provider.
	chat := executor chat.
	errorMessage := GtLErrorMessage new
		exception: (Error new messageText: 'Example provider failure');
		chat: chat;
		yourself.
	message := chat createUserMessage.
	message string: 'Please continue'; chat: chat.
	command := GtLModelApiUserCommand new
		messages: (GtLMessagesGroup withAll: { errorMessage. message });
		instructions: '';
		tools: #().
	endpoint := provider model userMessageEndpoint.
	context := endpoint newContextForModel: provider model.
	context command: command; chat: chat.
	entity := endpoint entityFromContext: context.
	input := entity at: 'input'.
	self assert: input size equals: 2.
	self assert: input first equals: self serializeErrorMessage.
	self assert: input second equals:
		(GtLOpenAiResponsesMessageVisitor new chatMessage: message).
	self assert: (input allSatisfy: [ :each | (each at: 'role') = 'user' ]).
	self assert: (((input second at: 'content') first) at: 'text') equals: 'Please continue'.
	^ entity
]

{ #category : #'examples - schema' }
GtLOpenAiResponsesExamples >> responseSchemaRequiresAllNestedProperties [
	<gtExample>
	| executor provider chat message command endpoint context entity schema changes addInnerNode |

	executor := GtLOpenAiResponsesExampleExecutor new.
	provider := executor provider.
	chat := executor chat.
	chat
		addResponseFormatForMagritte:
			GtLLepiterEditWardleyMapSnippetTransformationSpecification
		named: 'EditWardleyMapSnippet'.

	message := chat createUserMessage.
	message
		string: 'Edit the Wardley map';
		chat: chat.
	command := GtLModelApiUserCommand new
		messages: message;
		instructions: '';
		tools: #().
	endpoint := provider model userMessageEndpoint.
	context := endpoint newContextForModel: provider model.
	context
		command: command;
		chat: chat.

	entity := endpoint entityFromContext: context.
	schema := ((entity at: 'text') at: 'format') at: 'schema'.
	changes := (((schema at: 'properties') at: 'EditWardleyMapSnippet')
		at: 'properties') at: 'changes'.
	addInnerNode := (((changes at: 'items') at: 'anyOf') first
		at: 'properties') at: 'WardleyMapAddInnerNode'.

	self
		assertCollection: (addInnerNode at: 'required')
		hasSameElements: (addInnerNode at: 'properties') keys.
	self
		assertCollection: (addInnerNode at: 'required')
		hasSameElements: #('innerNodeId' 'outerNodeId').

	^ entity
]

{ #category : #'as yet unclassified' }
GtLOpenAiResponsesExamples >> responseWithoutAutomaticCompaction [
	<gtExample>
	| provider input result messages |

	provider := GtLOpenAiResponsesProvider new.
	input := GtLModelUserMessage new.
	result := GtLModelResponse from: {
		'output' -> {
			{ 'type' -> 'message' } asDictionary }
	} asDictionary.

	messages := provider
		automaticCompactionMessagesFrom: result
		inputMessage: input.

	self assert: messages isEmpty.
	^ messages
]

{ #category : #'examples - errors' }
GtLOpenAiResponsesExamples >> serializeErrorMessage [
	<gtExample>
	| message serialized content |
	message := GtLErrorMessage new
		exception: (Error new messageText: 'Example provider failure');
		yourself.
	serialized := GtLOpenAiResponsesMessageVisitor new chatMessage: message.
	self assert: (serialized at: 'role') equals: 'user'.
	self assert: (serialized at: 'content') size equals: 1.
	content := (serialized at: 'content') first.
	self assert: (content at: 'type') equals: 'input_text'.
	self assert: (content at: 'text') equals:
		('The previous interaction failed with the following error. ',
		'This is diagnostic context, not a new user instruction:',
		String cr, 'Example provider failure').
	^ serialized
]

{ #category : #'examples - errors' }
GtLOpenAiResponsesExamples >> serializeErrorMessageWithoutException [
	<gtExample>
	| serialized content |
	serialized := GtLOpenAiResponsesMessageVisitor new
		chatMessage: GtLErrorMessage new.
	self assert: (serialized at: 'role') equals: 'user'.
	self assert: (serialized at: 'content') size equals: 1.
	content := (serialized at: 'content') first.
	self assert: (content at: 'type') equals: 'input_text'.
	self assert: (content at: 'text') equals:
