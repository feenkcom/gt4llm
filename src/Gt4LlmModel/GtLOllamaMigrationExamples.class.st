{ #category : #examples }
GtLOllamaMigrationExamples >> gemma4ResponsesStringChat [
	"Check operation of the Ollama endpoint using a fake client"
	<gtExample>
	| executor provider chat |

	executor := GtLOllamaResponsesExampleExecutor new.
	executor loadExpectedHistoryFrom: self gemma4ResponsesStringChatHistory.
	provider := executor provider.
	provider modelName: 'gemma4:e4b'.
	chat := executor chat.
	chat markdownResponse.

	chat sendString: 'Hi, who are you?'.
	executor waitTimeoutSeconds: 60.

	executor assertChatResponseOK: chat.
	GtLModelExamples
		compareShapes: chat messages
		with: executor expectedHistory.
	executor assertResponseStringContent: chat messages last.

	^ chat
]

