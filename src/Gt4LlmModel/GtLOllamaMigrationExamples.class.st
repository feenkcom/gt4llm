{ #category : #examples }
GtLOllamaMigrationExamples >> modelDetails [
	"Answer the model details of the running system.
	If running live: Assumes that tinyllama is already downloaded, see pullTinyllama."
	<gtExample>
	| executor provider model modelDetails details history request contents |

	executor := GtLOllamaGenerateExampleExecutor new.
	executor loadExpectedHistoryFrom: self modelDetailsHistory.
	provider := executor provider.
	provider modelName: 'tinyllama'.
	model := provider model.

	modelDetails := provider modelDetails.
	executor assertHistoryResponsesOK: model client history.
	history := provider client history.
	self assert: history size equals: 1.
	request := history first request.
	self assert: request uri path equals: 'api/show'.
	contents := history requestContentsAt: 1.
	self assert: contents size equals: 1.
	self assert: (contents at: 'model') equals: 'tinyllama'.
	details := modelDetails at: 'details'
		ifPresent: [ :dict | dict ]
		ifAbsent: [ AssertionFailure signal: 'model details not present' ].
	self assert: (details at: 'family') equals: 'llama'.
	^ modelDetails
]

