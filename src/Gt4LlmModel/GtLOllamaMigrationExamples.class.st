Class {
	#name : #GtLOllamaMigrationExamples,
	#superclass : #GtLModelExamples,
	#category : #'Gt4LlmModel-Examples'
}

{ #category : #management }
GtLOllamaMigrationExamples class >> embeddingsSourceFrom: anArray selector: aSymbol [
	"Generate the source code that will recreate the supplied array of embeddings.
	Store the required data as an array:
	{ embeddings input. embeddings embeddings. queryEmbeddings input. queryEmbeddings embeddings. }.
	embeddings and queryEmbeddings are both instances of GtLModelEmbeddings."
	| embeddings queryEmbeddings |

	embeddings := anArray first.
	queryEmbeddings := anArray second.
	
	^ String streamContents: [ :stream |
		stream
			<< aSymbol; lf;
			lf;
			tab; << '^ '.
		stream nextPutAll: {
			embeddings input.
			embeddings rawData at: 'embeddings'.
			queryEmbeddings input.
			queryEmbeddings rawData at: 'embeddings'.
			} storeString. ].
]

{ #category : #examples }
GtLOllamaMigrationExamples >> deleteTinyllama [
	"Delete tinyllama with Ollama.
	If running live: Assumes that tinyllama is already downloaded, see pullTinyllama."
	<gtExample>
	| executor provider result model history request contents|

	executor := GtLOllamaGenerateExampleExecutor new.
	executor loadExpectedHistoryFrom: self modelDetailsHistory.
	provider := executor provider.
	provider modelName: 'tinyllama'.
	model := provider model.

	result := provider deleteModel.
	executor assertHistoryResponsesOK: provider client history.
	self assert: result equals: 'success'.
	history := provider client history.
	self assert: history size equals: 1.
	request := history first request.
	self assert: request uri path equals: 'api/delete'.
	contents := history requestContentsAt: 1.
	self assert: contents size equals: 1.
	self assert: (contents at: 'model') equals: 'tinyllama'.

	^ provider
]

{ #category : #examples }
GtLOllamaMigrationExamples >> gemma4CompletionsChat [
	"Check operation of the Ollama completions endpoint.
	input and output formatting doesn't work with most models, so is not tested."
	<gtExample>
	| executor provider chat |

	executor := GtLOllamaCompletionsExampleExecutor new.
	executor loadExpectedHistoryFrom: self gemma4CompletionsChatHistory.
	provider := executor provider.
	provider modelName: 'gemma4:e4b'.
	chat := executor chat.

	chat
		reasoningEffort: #none;
		sendString: 'Hi, who are you?'.
	executor waitTimeoutSeconds: 30.
	GtLModelExamples
		compareShapes: chat messages
		with: executor expectedHistory.
	executor assertResponseCompletionsStringContent: chat messages last finalMessage.

	^ chat
]

